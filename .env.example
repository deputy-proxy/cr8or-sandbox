# Authentication for the remote MCP endpoint
MCP_AUTH_TOKEN=replace-with-a-long-random-token

# Railway credentials used by the Sandbox SDK
RAILWAY_TOKEN=replace-with-a-Railway-project-token
RAILWAY_ENVIRONMENT_ID=replace-with-your-environment-id

# Optional. Comma-separated hostnames accepted by MCP host validation.
# Leave unset only when the bearer token is your sole network protection.
ALLOWED_HOSTS=your-service.up.railway.app

PORT=3000
