    "railway": "3.11.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/express": "5.0.5",
    "@types/node": "26.5.1",
    "tsx": "4.20.6",
    "typescript": "6.0.3"
  }
